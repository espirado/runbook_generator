# Source can be fixture, aws, eks, or kubernetes.
RUNBOOK_SOURCE=eks

# Scope for the runbook.
RUNBOOK_ENVIRONMENT=replace-me-environment
RUNBOOK_AWS_ACCOUNT=replace-me-aws-account-id
RUNBOOK_AWS_REGION=replace-me-aws-region
RUNBOOK_EKS_CLUSTER=replace-me-eks-cluster-name
RUNBOOK_K8S_NAMESPACE=replace-me-kubernetes-namespace
RUNBOOK_SERVICE=replace-me-service-or-workload-name
RUNBOOK_KUBE_CONTEXT=replace-me-kubectl-context

# Output paths.
RUNBOOK_OUTPUT=runbooks/replace-me-service-or-workload-name.md
RUNBOOK_SNAPSHOT_OUTPUT=runbooks/replace-me-service-or-workload-name.snapshot.json
