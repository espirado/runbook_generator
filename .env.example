# Source can be fixture, aws, eks, or kubernetes.
RUNBOOK_SOURCE=eks

# Scope for the runbook.
RUNBOOK_ENVIRONMENT=replace-me-environment
RUNBOOK_AWS_ACCOUNT=replace-me-aws-account-id
RUNBOOK_AWS_REGION=replace-me-aws-region
RUNBOOK_EKS_CLUSTER=replace-me-eks-cluster-name
RUNBOOK_K8S_NAMESPACE=replace-me-kubernetes-namespace
RUNBOOK_SERVICE=replace-me-service-or-workload-name
RUNBOOK_KUBE_CONTEXT=replace-me-kubectl-context

# Output paths.
RUNBOOK_OUTPUT=runbooks/replace-me-service-or-workload-name.md
RUNBOOK_SNAPSHOT_OUTPUT=runbooks/replace-me-service-or-workload-name.snapshot.json

# Agent/reporting package.
RUNBOOK_AGENT_OUTPUT_DIR=ops-package/replace-me-service-or-workload-name

# Observability signal source. Keep tokens in the platform CLI/secret manager;
# this prototype only needs endpoint/query metadata for report context.
RUNBOOK_OBSERVABILITY_PROVIDER=replace-me-observability-provider
RUNBOOK_OBSERVABILITY_BASE_URL=https://replace-me-observability.example.invalid
RUNBOOK_OBSERVABILITY_QUERY=replace-me-query
RUNBOOK_OBSERVABILITY_DASHBOARD_URL=https://replace-me-dashboard.example.invalid

# Documentation and incident-management destinations.
RUNBOOK_CONFLUENCE_BASE_URL=https://replace-me-confluence.example.invalid
RUNBOOK_CONFLUENCE_SPACE_KEY=replace-me-space-key
RUNBOOK_CONFLUENCE_PARENT_PAGE_ID=replace-me-parent-page-id
RUNBOOK_JIRA_BASE_URL=https://replace-me-jira.example.invalid
RUNBOOK_JIRA_PROJECT_KEY=replace-me-project-key
RUNBOOK_JIRA_ISSUE_TYPE=Incident
RUNBOOK_WIKI_BASE_URL=https://replace-me-wiki.example.invalid

# Slack notifications. Keep webhook URLs in a secret manager or local env.
# RUNBOOK_SLACK_SEND must be true before a webhook call is attempted.
RUNBOOK_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace-me
RUNBOOK_SLACK_CHANNEL=#replace-me-channel
RUNBOOK_SLACK_USERNAME=runbook-generator
RUNBOOK_SLACK_SEND=false
